# Required for title generation, summaries, extraction, and RAG chat
MISTRAL_API_KEY=

# Fast LLM provider used by default
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
MISTRAL_MODEL=mistral-small-latest

# Required only when Language is set to hinglish
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v2.5

# Optional local Whisper model: tiny, base, small, medium, or large
WHISPER_MODEL=tiny